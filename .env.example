# Local deterministic mode starts without credentials or model downloads.
AGENT_MODE=demo
INSTALL_AGENT_DEPS=false
LOG_LEVEL=INFO
CASE_TIMEOUT_SECONDS=90

# Optional LLM workflow: set AGENT_MODE=langgraph and INSTALL_AGENT_DEPS=true.
# Provide the provider credential through your local .env file or secret store.
GEMINI_MODEL=
GOOGLE_API_KEY=
